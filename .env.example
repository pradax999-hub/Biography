# ─────────────────────────────────────────────────────────────────────────────
# NIGHTWNTR 2.0 — server settings
#
# Copy this file to `.env` for local development. In production set the same
# variables in Netlify: Site configuration → Environment variables.
# Nothing here is ever sent to the browser. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the site, without a trailing slash. Used for the links the
# payment provider sends the customer back to. Optional: when empty, the
# address of the incoming request is used. Production: https://nightwntr.com
SITE_URL=

# ── Online card payments ─────────────────────────────────────────────────────
# stripe   real provider (test keys = test mode, live keys = real money)
# sandbox  built-in simulator, no account needed, no money moves
# (empty)  card payments are switched off; QR transfer, link and chat still work
#
# `npm run dev` switches the sandbox on by itself when this is empty.
PAYMENT_PROVIDER=

# Stripe → Developers → API keys → Secret key (sk_test_… or sk_live_…)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Only for PAYMENT_PROVIDER=sandbox: any long random string, e.g. `openssl rand -hex 32`
SANDBOX_WEBHOOK_SECRET=

# ── Telegram notifications for the owner ─────────────────────────────────────
# Create a bot with @BotFather, send it any message from your account, then
# open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# full     the whole order text (name, contact, task) — same as the customer sees
# minimal  reference, service and amounts only
TELEGRAM_NOTIFY_DETAIL=full

# ── Owner API (/api/admin/*) ─────────────────────────────────────────────────
# Long random string. While empty, the admin API does not exist.
ADMIN_TOKEN=

# ── Storage (normally leave empty) ───────────────────────────────────────────
# blobs   Netlify Blobs — chosen automatically on Netlify
# file    JSON files in ORDER_DATA_DIR — chosen automatically everywhere else
# memory  nothing is kept — tests only
ORDER_STORE=
ORDER_DATA_DIR=.data
